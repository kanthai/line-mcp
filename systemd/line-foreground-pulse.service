[Unit]
Description=Periodically foreground LINE inside Waydroid
After=multi-user.target
After=waydroid-watchdog.service
Wants=waydroid-watchdog.service

[Service]
Type=oneshot
User=root
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/home/kanthai/line-mcp/tools/line-foreground-pulse.sh
StandardOutput=journal
StandardError=journal
