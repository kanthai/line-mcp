[Unit]
Description=Refresh LINE CDN auth token from SQLite DB
After=waydroid-watchdog.service
Wants=waydroid-watchdog.service

[Service]
Type=oneshot
User=root
Environment=HOME=/home/kanthai
WorkingDirectory=/home/kanthai/line-mcp
ExecStart=/home/kanthai/line-mcp/venv/bin/python3 /home/kanthai/line-mcp/tools/refresh_token.py
StandardOutput=journal
StandardError=journal
