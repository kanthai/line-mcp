[Unit]
Description=Keep LINE running inside Waydroid and verify SSE endpoint
After=multi-user.target
After=waydroid-watchdog.service
Wants=waydroid-watchdog.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/line-mcp-watchdog.env
ExecStart=/home/kanthai/line-mcp/tools/line-watchdog-vm.sh
StandardOutput=journal
StandardError=journal
