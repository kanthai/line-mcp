[Unit]
Description=VNC server for Xvfb display :0
After=xvfb.service
Requires=xvfb.service

[Service]
Type=simple
User=kanthai
ExecStart=/usr/bin/x11vnc -display :0 -forever -noxdamage -passwd VNC_PASSWORD_PLACEHOLDER -rfbport 5900 -listen 0.0.0.0
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
