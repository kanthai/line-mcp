[Unit]
Description=LINE Accounting Agent
After=network.target
After=line-watchdog.service

[Service]
Type=simple
User=kanthai
WorkingDirectory=/home/kanthai/workspace/line-accounting-agent
Environment=PATH=/home/kanthai/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/kanthai/workspace/shared/models.env
EnvironmentFile=/home/kanthai/workspace/line-accounting-agent/.env
ExecStart=/home/kanthai/workspace/line-accounting-agent/.venv/bin/python /home/kanthai/workspace/line-accounting-agent/main.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
