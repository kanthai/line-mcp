# /etc/line-mcp/line-mcp.env — environment for every line-mcp systemd unit.
# Install with:  install -m 600 -o root -g root config/line-mcp.env.example /etc/line-mcp/line-mcp.env
# then edit.  Never commit the real file.

# ── Required ──────────────────────────────────────────────────────────────────
# Bearer token MCP clients must send (Authorization: Bearer <key>  or  ?key=<key>).
# Generate:  python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
LINE_MCP_API_KEY=change-me

# Where the live LINE SQLite databases live on the LXC host (inside the redroid-data Docker volume).
LINE_MCP_HOST_DB=/var/lib/docker/volumes/redroid-data/_data/data/jp.naver.line.android/databases/naver_line
LINE_MCP_HOST_CONTACT_DB=/var/lib/docker/volumes/redroid-data/_data/data/jp.naver.line.android/databases/contact

# ── Read path ─────────────────────────────────────────────────────────────────
# direct   — read the SQLite files above (simplest; the service user must be able to open them)
# postgres — read the line_raw/cdb mirror kept fresh by line-sync-postgres.service (what CT103 runs)
# auto     — postgres if DATABASE_URL is set and reachable, else direct
LINE_MCP_DB_MODE=direct
# Required for postgres mode (and for line-sync-postgres.service):
#DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ── Optional ──────────────────────────────────────────────────────────────────
# Public base URL under which this server serves downloaded media (/files is Bearer-protected).
# Should be the address MCP clients use to reach this host.
#LINE_MCP_MEDIA_URL=http://11.0.0.103:8765/files
# Max concurrent LINE DB / CDN operations (default 2).
#LINE_MCP_MAX_CONCURRENCY=2
# ADB serial of the Redroid container (default 127.0.0.1:5555).
#LINE_ADB_DEVICE=127.0.0.1:5555
# CDN base for media blobs (default Thailand region).
#LINE_CDN_BASE=https://obs-th.line-apps.com/r/talk
# Token-refresh knobs (see RUNBOOK.md):
#LINE_TOKEN_REFRESH_MAX_CANDIDATES=5
#LINE_TOKEN_REFRESH_WAIT_SECONDS=15
#LINE_TOKEN_REFRESH_CHAT_ID=
# Seconds between Postgres mirror sync passes (line-sync-postgres.service; default 5, CT103 uses 30).
#LINE_SYNC_INTERVAL_SECONDS=30
